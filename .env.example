# Anthropic — required for drafter and verifier
ANTHROPIC_API_KEY=

# Embeddings — Voyage primary, OpenAI fallback. Set one.
VOYAGE_API_KEY=
OPENAI_API_KEY=

# Postgres with pgvector. Example:
#   docker run -p 5432:5432 -e POSTGRES_PASSWORD=postgres pgvector/pgvector:pg16
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/grants

# Phase 2 (optional now)
PROPUBLICA_API_KEY=

# Models
DRAFTER_MODEL=claude-opus-4-7
VERIFIER_MODEL=claude-opus-4-7
SUBTASK_MODEL=claude-sonnet-4-6

# Embeddings
EMBEDDING_PROVIDER=voyage     # voyage | openai
EMBEDDING_MODEL=voyage-3      # or text-embedding-3-large

# Behavior
LOG_LEVEL=INFO
